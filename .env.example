# ──────────────────────────────────────────────────
# Notes API — Environment Variables
# ──────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
#   cp .env.example .env
# ──────────────────────────────────────────────────

# Django core
SECRET_KEY=change-me-to-a-long-random-string-at-least-50-characters
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (leave blank for SQLite, or use a Postgres URL)
# DATABASE_URL=postgresql://user:password@localhost:5432/notes_db
DATABASE_URL=

# CORS — comma-separated frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT token lifetimes
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=90

# Production only
SECURE_SSL_REDIRECT=False

# ──────────────────────────────────────────────────
# Production Deployment Variables
# ──────────────────────────────────────────────────

# For production, update these values:
# ALLOWED_HOSTS=your-backend-domain.com,your-backend.onrender.com
# CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://your-custom-domain.com
# DEBUG=False
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# SECURE_SSL_REDIRECT=True
